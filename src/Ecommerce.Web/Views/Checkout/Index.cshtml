@model Ecommerce.Core.ViewModels.CheckoutViewModel
@using Ecommerce.Core.ViewModels
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Checkout";

    var cart = ViewBag.Cart as CartViewModel;
    var subtotal = cart == null ? 0m : cart.Subtotal;
    var itemCount = cart == null ? 0 : cart.ItemCount;
}
<link rel="stylesheet" href="/Content/checkout-page.css" />
<link rel="stylesheet" href="/Content/floating-app-theme.css" />


<div class="checkout-page">
    <header class="checkout-header">
        <a class="checkout-brand" href="/">
            <span class="checkout-brand-mark">L</span>
            <span>Legacy<span>Shop</span></span>
        </a>

        <div class="checkout-header-center">
            <span class="secure-dot">✓</span>
            <span>Secure Checkout</span>
        </div>

        <a class="back-cart" href="/Cart">← Back to Cart</a>
    </header>

    <main class="checkout-main">
        <div class="checkout-heading">
            <span class="checkout-kicker">CHECKOUT</span>
            <h1>Almost there.</h1>
            <p>Confirm where your LegacyShop order should be delivered.</p>
        </div>

        <div class="checkout-progress">
            <div class="progress-step active">
                <span>1</span>
                <div><strong>Address</strong><small>Delivery details</small></div>
            </div>
            <i></i>
            <div class="progress-step">
                <span>2</span>
                <div><strong>Shipping</strong><small>Standard delivery</small></div>
            </div>
            <i></i>
            <div class="progress-step">
                <span>3</span>
                <div><strong>Confirm</strong><small>Place order</small></div>
            </div>
        </div>

        <div class="checkout-layout">
            <section class="checkout-card address-card">
                <div class="card-heading">
                    <div>
                        <span class="card-kicker">STEP 1 OF 3</span>
                        <h2>Delivery address</h2>
                    </div>
                    <div class="secure-badge">⌂ Secure</div>
                </div>

                @Html.ValidationSummary(true, "", new { @class = "checkout-validation" })

                @using (Html.BeginForm("Index", "Checkout", FormMethod.Post, new { @class = "checkout-form" }))
                {
                    @Html.AntiForgeryToken()

                    <div class="field wide">
                        <label>Full name</label>
                        @Html.TextBoxFor(m => m.FullName, new {
                            placeholder = "Your full name",
                            autocomplete = "name",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "field-error" })
                    </div>

                    <div class="field wide">
                        <label>Address line 1</label>
                        @Html.TextBoxFor(m => m.Line1, new {
                            placeholder = "Street and house / apartment",
                            autocomplete = "address-line1",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.Line1, "", new { @class = "field-error" })
                    </div>

                    <div class="field wide">
                        <label>Address line 2 <small>Optional</small></label>
                        @Html.TextBoxFor(m => m.Line2, new {
                            placeholder = "Landmark, building, area",
                            autocomplete = "address-line2"
                        })
                    </div>

                    <div class="field">
                        <label>City</label>
                        @Html.TextBoxFor(m => m.City, new {
                            placeholder = "City",
                            autocomplete = "address-level2",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.City, "", new { @class = "field-error" })
                    </div>

                    <div class="field">
                        <label>State</label>
                        @Html.TextBoxFor(m => m.State, new {
                            placeholder = "State",
                            autocomplete = "address-level1",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.State, "", new { @class = "field-error" })
                    </div>

                    <div class="field">
                        <label>Postal code</label>
                        @Html.TextBoxFor(m => m.PostalCode, new {
                            placeholder = "Postal code",
                            autocomplete = "postal-code",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.PostalCode, "", new { @class = "field-error" })
                    </div>

                    <div class="field">
                        <label>Country</label>
                        @Html.TextBoxFor(m => m.Country, new {
                            placeholder = "Country",
                            autocomplete = "country-name",
                            required = "required"
                        })
                        @Html.ValidationMessageFor(m => m.Country, "", new { @class = "field-error" })
                    </div>

                    <div class="delivery-choice">
                        <div class="choice-icon">↗</div>
                        <div>
                            <strong>Standard delivery</strong>
                            <span>Demo shipping option · no delivery fee</span>
                        </div>
                        <b>FREE</b>
                    </div>

                    <div class="demo-payment">
                        <span>◇</span>
                        <div>
                            <strong>Demo payment</strong>
                            <p>No live card transaction is collected in this project.</p>
                        </div>
                    </div>

                    <button class="place-order-btn" type="submit">
                        <span>Place Order</span>
                        <b>→</b>
                    </button>

                    <p class="terms-note">
                        By placing the order, you confirm the delivery details above.
                    </p>
                }
            </section>

            <aside class="checkout-summary">
                <section class="summary-card">
                    <div class="summary-heading">
                        <div>
                            <span class="card-kicker">YOUR ORDER</span>
                            <h2>Order summary</h2>
                        </div>
                        <span class="item-count">@itemCount item@(itemCount == 1 ? "" : "s")</span>
                    </div>

                    @if (cart != null)
                    {
                        <div class="summary-items">
                        @foreach (var item in cart.Items)
                        {
                            <div class="summary-item">
                                <div class="summary-thumb">@item.Name.Substring(0, 1)</div>
                                <div class="summary-item-info">
                                    <strong>@item.Name</strong>
                                    <span>Qty @item.Quantity · ₹@item.Price.ToString("N0") each</span>
                                </div>
                                <b>₹@((item.Price * item.Quantity).ToString("N0"))</b>
                            </div>
                        }
                        </div>
                    }

                    <div class="summary-values">
                        <div><span>Subtotal</span><strong>₹@subtotal.ToString("N0")</strong></div>
                        <div><span>Delivery</span><strong class="free">FREE</strong></div>
                        <div><span>Payment</span><strong>Demo</strong></div>
                    </div>

                    <div class="summary-total">
                        <div><span>Total</span><small>Free standard delivery</small></div>
                        <strong>₹@subtotal.ToString("N0")</strong>
                    </div>
                </section>

                <section class="checkout-trust">
                    <div><span>✓</span><div><strong>Protected checkout</strong><small>Anti-forgery protected form</small></div></div>
                    <div><span>✓</span><div><strong>Order history</strong><small>Orders appear in your customer dashboard</small></div></div>
                    <div><span>✓</span><div><strong>Secure session cart</strong><small>Your cart is cleared after successful order placement</small></div></div>
                </section>
            </aside>
        </div>
    </main>
</div>

<script src="/Scripts/floating-app-theme.js"></script>

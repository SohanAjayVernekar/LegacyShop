@model System.Collections.Generic.IList<Ecommerce.Core.Entities.Product>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Wishlist";
    ViewData["CustomerSection"] = "Wishlist";
    var suggestions = ViewBag.Suggestions as System.Collections.Generic.IList<Ecommerce.Core.Entities.Product>;
}
<link rel="stylesheet" href="/Content/customer-pages.css" />
<link rel="stylesheet" href="/Content/floating-app-theme.css" />
<link rel="stylesheet" href="/Content/product-3d-visuals.css" />



<div class="cp-shell">
    @Html.Partial("_CustomerSidebar")
    <main class="cp-main">
        @Html.Partial("_CustomerTopbar")

        <section class="cp-content">
            <div class="cp-heading">
                <div>
                    <span class="cp-kicker">SAVED FOR LATER</span>
                    <h1>Wishlist</h1>
                    <p>Keep products you want to revisit before checkout.</p>
                </div>
                <a class="cp-btn" href="/Product">Browse Products →</a>
            </div>

            <section class="cp-panel">
                <div class="cp-panel-head">
                    <div><small>YOUR SAVED ITEMS</small><h2>@Model.Count item@(Model.Count == 1 ? "" : "s")</h2></div>
                </div>

                @if (Model.Count == 0)
                {
                    <div class="cp-empty">
                        <b>Your wishlist is empty.</b>
                        <span>Add one of the suggested products below.</span>
                    </div>
                }
                else
                {
                    <div class="cp-wishlist-grid">
                    @foreach (var product in Model)
                    {
                        <article class="cp-product">
                            <a href="/Product/Detail/@product.Id">
                                <div class="cp-product-art">@product.Name.Substring(0,1)</div>
                            </a>
                            <div class="cp-product-body">
                                <small>@(product.Category == null ? "PRODUCT" : product.Category.Name.ToUpperInvariant())</small>
                                <h3>@product.Name</h3>
                                <div class="cp-product-meta"><strong>₹@product.Price.ToString("N0")</strong><span>@product.StockQuantity in stock</span></div>

                                @using (Html.BeginForm("WishlistRemove", "Customer", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="cp-btn secondary small">Remove</button>
                                }
                            </div>
                        </article>
                    }
                    </div>
                }
            </section>

            <section class="cp-panel">
                <div class="cp-panel-head"><div><small>DISCOVER</small><h2>Quick Add</h2></div><a href="/Product">View catalog →</a></div>

                <div class="cp-suggest-grid">
                @if (suggestions != null)
                {
                    foreach (var product in suggestions)
                    {
                        <article class="cp-product">
                            <a href="/Product/Detail/@product.Id">
                                <div class="cp-product-art">@product.Name.Substring(0,1)</div>
                            </a>
                            <div class="cp-product-body">
                                <small>@(product.Category == null ? "PRODUCT" : product.Category.Name.ToUpperInvariant())</small>
                                <h3>@product.Name</h3>
                                <div class="cp-product-meta"><strong>₹@product.Price.ToString("N0")</strong><span>@product.StockQuantity in stock</span></div>

                                @using (Html.BeginForm("WishlistAdd", "Customer", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="cp-btn small">♡ Save Item</button>
                                }
                            </div>
                        </article>
                    }
                }
                </div>
            </section>
        </section>
    </main>
</div>

<script src="/Scripts/floating-app-theme.js"></script>

<script src="/Scripts/product-3d-visuals.js"></script>

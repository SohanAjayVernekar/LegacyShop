@model System.Collections.Generic.IList<Ecommerce.Core.Entities.Order>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Orders";
    ViewData["CustomerSection"] = "Orders";
}
<link rel="stylesheet" href="/Content/customer-pages.css" />
<link rel="stylesheet" href="/Content/floating-app-theme.css" />


<div class="cp-shell">
    @Html.Partial("_CustomerSidebar")
    <main class="cp-main">
        @Html.Partial("_CustomerTopbar")

        <section class="cp-content">
            <div class="cp-heading">
                <div>
                    <span class="cp-kicker">ORDER HISTORY</span>
                    <h1>My Orders</h1>
                    <p>Track every LegacyShop purchase from one place.</p>
                </div>
                <a class="cp-btn" href="/Product">Shop Again →</a>
            </div>

            <div class="cp-stats">
                <article class="cp-stat"><span>Total Orders</span><strong>@Model.Count</strong><small>all purchases</small></article>
                <article class="cp-stat"><span>In Progress</span><strong>@Model.Count(x => x.Status == "Processing" || x.Status == "Packed" || x.Status == "Shipped")</strong><small>active orders</small></article>
                <article class="cp-stat"><span>Delivered</span><strong>@Model.Count(x => x.Status == "Delivered")</strong><small>completed orders</small></article>
            </div>

            <section class="cp-panel">
                <div class="cp-panel-head"><div><small>PURCHASES</small><h2>Order History</h2></div></div>

                @if (Model.Count == 0)
                {
                    <div class="cp-empty">
                        <b>No orders yet.</b>
                        <span>Your placed orders will appear here.</span>
                        <a class="cp-btn" href="/Product">Start Shopping</a>
                    </div>
                }
                else
                {
                    <div class="cp-order-list">
                    @foreach (var order in Model)
                    {
                        <article class="cp-order">
                            <div class="cp-order-top">
                                <div><small>Order</small><strong>@order.OrderNumber</strong></div>
                                <div><small>Placed</small><strong>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                                <div><small>Total</small><strong>₹@order.TotalAmount.ToString("N0")</strong></div>
                                <div><span class="cp-status @(order.Status == "Delivered" ? "ok" : order.Status == "Cancelled" ? "bad" : "warn")">@order.Status</span></div>
                            </div>

                            <div class="cp-order-lines">
                                @foreach (var line in order.Lines)
                                {
                                    <div class="cp-line">
                                        <strong>@line.ProductName</strong>
                                        <span>Qty @line.Quantity</span>
                                        <span>₹@((line.UnitPrice * line.Quantity).ToString("N0"))</span>
                                    </div>
                                }
                            </div>
                        </article>
                    }
                    </div>
                }
            </section>
        </section>
    </main>
</div>

<script src="/Scripts/floating-app-theme.js"></script>

@model Ecommerce.Core.ViewModels.CartViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Shopping Cart";
}
<link rel="stylesheet" href="/Content/cart-page.css" />
<link rel="stylesheet" href="/Content/floating-app-theme.css" />
<link rel="stylesheet" href="/Content/product-3d-visuals.css" />



<div class="cart-page">
    <header class="cart-header">
        <a class="cart-brand" href="/">
            <span class="cart-brand-mark">L</span>
            <span>Legacy<span>Shop</span></span>
        </a>

        <nav class="cart-nav">
            <a href="/Product">Shop</a>
            <a href="/Customer/Orders">Orders</a>
            <a href="/Customer/Wishlist">Wishlist</a>
            <a href="/Customer/Dashboard">My Account</a>
        </nav>
    </header>

    <main class="cart-main">
        <section class="cart-heading">
            <div>
                <span class="cart-kicker">YOUR BAG</span>
                <h1>Shopping Cart</h1>
                <p>@Model.ItemCount item@(Model.ItemCount == 1 ? "" : "s") ready for checkout.</p>
            </div>

            @if (Model.Items.Count > 0)
            {
                using (Html.BeginForm("Clear", "Cart", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <button class="clear-cart" type="submit">Clear cart</button>
                }
            }
        </section>

        @if (Model.Items.Count == 0)
        {
            <section class="cart-empty">
                <div class="empty-orbit">
                    <div class="empty-bag">◇</div>
                    <span class="spark spark-a">✦</span>
                    <span class="spark spark-b">✧</span>
                </div>

                <h2>Your cart is waiting.</h2>
                <p>Browse the marketplace and add something you like.</p>
                <a class="cart-primary" href="/Product">Explore Products →</a>
            </section>
        }
        else
        {
            <div class="cart-layout">
                <section class="cart-items-panel">
                    <div class="cart-section-head">
                        <div>
                            <small>CART ITEMS</small>
                            <h2>Your selection</h2>
                        </div>
                        <span>@Model.Items.Count product@(Model.Items.Count == 1 ? "" : "s")</span>
                    </div>

                    <div class="cart-items">
                    @foreach (var item in Model.Items)
                    {
                        var artClass = item.ProductId % 4 == 0
                            ? "art-gold"
                            : item.ProductId % 4 == 1
                                ? "art-brown"
                                : item.ProductId % 4 == 2
                                    ? "art-sage"
                                    : "art-stone";

                        <article class="cart-item">
                            <a class="cart-thumb @artClass" href="/Product/Detail/@item.ProductId">
                                @if (!string.IsNullOrWhiteSpace(item.ThumbnailUrl))
                                {
                                    <img src="@item.ThumbnailUrl" alt="@item.Name" />
                                }
                                else
                                {
                                    <span>@item.Name.Substring(0,1)</span>
                                }
                            </a>

                            <div class="cart-item-info">
                                <span class="cart-item-label">LEGACYSHOP PRODUCT</span>
                                <a href="/Product/Detail/@item.ProductId">
                                    <h3>@item.Name</h3>
                                </a>
                                <small>Available · Ready to ship</small>

                                <div class="cart-item-actions">
                                    @using (Html.BeginForm("Update", "Cart", FormMethod.Post, new { @class = "quantity-form" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <label>Qty</label>
                                        <input type="number" name="quantity" min="0" max="99" value="@item.Quantity" />
                                        <button type="submit">Update</button>
                                    }

                                    @using (Html.BeginForm("Remove", "Cart", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId" />
                                        <button class="remove-btn" type="submit">Remove</button>
                                    }
                                </div>
                            </div>

                            <div class="cart-item-price">
                                <strong>₹@((item.Price * item.Quantity).ToString("N0"))</strong>
                                <span>₹@item.Price.ToString("N0") each</span>
                            </div>
                        </article>
                    }
                    </div>

                    <div class="cart-continue">
                        <a href="/Product">← Continue Shopping</a>
                        <span>Secure session cart</span>
                    </div>
                </section>

                <aside class="cart-summary">
                    <div class="summary-card">
                        <span class="summary-kicker">ORDER SUMMARY</span>
                        <h2>Review your total</h2>

                        <div class="summary-row">
                            <span>Items</span>
                            <strong>@Model.ItemCount</strong>
                        </div>

                        <div class="summary-row">
                            <span>Subtotal</span>
                            <strong>₹@Model.Subtotal.ToString("N0")</strong>
                        </div>

                        <div class="summary-row">
                            <span>Delivery</span>
                            <strong class="free">FREE</strong>
                        </div>

                        <div class="summary-row muted">
                            <span>Taxes</span>
                            <strong>Calculated at checkout</strong>
                        </div>

                        <div class="summary-total">
                            <div>
                                <span>Total</span>
                                <small>Including free delivery</small>
                            </div>
                            <strong>₹@Model.Subtotal.ToString("N0")</strong>
                        </div>

                        <a class="checkout-btn" href="/Checkout">
                            Proceed to Checkout <span>→</span>
                        </a>

                        <div class="summary-trust">
                            <div><b>✓</b><span>Secure checkout</span></div>
                            <div><b>✓</b><span>Order tracking</span></div>
                            <div><b>✓</b><span>Customer support</span></div>
                        </div>
                    </div>

                    <div class="cart-benefit">
                        <span>✦</span>
                        <div>
                            <strong>LegacyShop checkout</strong>
                            <p>Your cart stays in the current session until checkout or logout.</p>
                        </div>
                    </div>
                </aside>
            </div>
        }
    </main>
</div>

<script src="/Scripts/floating-app-theme.js"></script>

<script src="/Scripts/product-3d-visuals.js"></script>
